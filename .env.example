# Code Defog — local configuration template
# Copy to .env and fill in your real values.  .env is gitignored.
# Real shell environment variables always take precedence over .env.

# Required for production AgentTeams mode (real DeepSeek LLM calls).
DEEPSEEK_API_KEY=sk-your-key-here

# Optional local project search roots. Separate multiple paths with your
# platform path separator (":" on macOS/Linux, ";" on Windows).
CODE_DEFOG_PROJECT_ROOTS=~/code:~/projects

# Independent human approval key. Keep this out of source control.
CODE_DEFOG_APPROVAL_KEY=replace-with-a-private-local-secret
